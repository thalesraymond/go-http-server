### Create User
# Creates a new user and returns the created user
POST http://localhost:8080/api/users HTTP/1.1
Content-Type: application/json

{"email": "thales@example.com", "password": "securepassword123"}

### Create User (invalid payload)
# Returns 400 Bad Request when the JSON payload is malformed
POST http://localhost:8080/api/users HTTP/1.1
Content-Type: application/json

{invalid json}

### Login
# Logs in a user and returns a the user object without password
POST http://localhost:8080/api/login HTTP/1.1
Content-Type: application/json

{"email": "thales@example.com", "password": "newsecurepassword123"}

### Login (invalid credentials)
# Returns 401 Unauthorized when the email or password is incorrect
POST http://localhost:8080/api/login HTTP/1.1
Content-Type: application/json

{"email": "thales@example.com", "password": "wrongpassword"}

### Update User
# Updates an existing user and returns the updated user
PUT http://localhost:8080/api/users HTTP/1.1
Content-Type: application/json
Authorization: Bearer <ACCESS_TOKEN>

{"email": "thales@example.com", "password": "newsecurepassword123"}

### Update User (invalid payload)
# Returns 400 Bad Request when the JSON payload is malformed
PUT http://localhost:8080/api/users HTTP/1.1
Content-Type: application/json

{invalid json}